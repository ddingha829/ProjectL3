# ==========================================================
# L2. — Taste Archive & Card Engine 환경변수 설정 (.env.local)
# ==========================================================
# ※ 아래 키를 입력하지 않아도 앱은 내장된 로컬 DB 및 한국어 문맥 분석 폴백 엔진으로 100% 정상 동작합니다.
# 실제 외부 API를 연결하고 싶을 때만 발급받아 입력해 주세요.

# 1. 카카오 로컬(장소/주소 검색) & 카카오톡 공유 API (https://developers.kakao.com)
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# 2. 영화 검색용 TMDB API (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# 3. AI 본문 요약(GOOD/NOTE 자동 추출) & AI 무드 스킨 생성용 Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 4. 테스터별 기록 저장용 Supabase (https://supabase.com)
#    비워두면 로컬 JSON 파일(data/l2_users.json)에 기기별로 저장됩니다 (로컬 개발 전용).
#    Settings → API → Project URL / service_role 키. ⚠️ service_role 키에는 절대 NEXT_PUBLIC_ 붙이지 마세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=photos
